# Database URLs
# When running outside containers (local cargo run / npm run dev):
DATABASE_URL=postgres://root_user:root_pass@localhost:5432/root_db
DATABASE_URL_TEST=postgres://root_user:root_pass@localhost:5433/root_db_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_SECS=604800

# Server Configuration
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# Facebook OAuth2
FACEBOOK_CLIENT_ID=your-facebook-app-id-here
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret-here
FACEBOOK_REDIRECT_URI=http://localhost:5173/auth/callback/facebook

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here
